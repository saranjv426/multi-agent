# Default/OpenAI-Compatible Configuration (kept for backward compatibility)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MAIN_MODEL=gpt-5
OPENAI_SUMMARY_MODEL=gpt-5-mini

# Provider-specific model routing for UI dropdown
# Mistral route
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_API_BASE=https://api.ai.it.ufl.edu
MISTRAL_MAIN_MODEL=mistral-small-3.1
MISTRAL_SUMMARY_MODEL=mistral-small-3.1

# GPT-5.2 route
GPT52_API_KEY=your_gpt52_api_key_here
GPT52_API_BASE=https://api.openai.com/v1
GPT52_MAIN_MODEL=gpt-5.2
GPT52_SUMMARY_MODEL=gpt-5.2

# Database Configuration (Railway PostgreSQL)
DATABASE_URL=postgresql://username:password@host:port/database
LOCAL_DATABASE_URL=sqlite:///./local_dev.db
ENABLE_SQLITE_FALLBACK=true
# Optional: logical schema isolation when sharing one Postgres DB across envs
# Use "public" for production and "dev" (or similar) for staging/dev.
DB_SCHEMA=public

# JWT Security
JWT_SECRET_KEY=your_super_secret_jwt_key_here_make_it_long_and_random

# Server Configuration  
HOST=127.0.0.1
PORT=8000
DEBUG=true
ENVIRONMENT=development
MAX_COMPLETION_TOKENS=4000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cost Tracking
TRACK_API_COSTS=true
LOG_LEVEL=INFO

# Frontend URL (for password reset emails)
FRONTEND_URL=http://localhost:3000

# Email Service (Optional - for password reset emails)
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=noreply@yourdomain.com
